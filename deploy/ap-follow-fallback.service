[Unit]
Description=Fetch recent notes for followed accounts on quiet ActivityPub hosts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/bin/php /srv/mkultra/html/api/ap-follow-fallback.php
NoNewPrivileges=true
