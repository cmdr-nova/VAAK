[Unit]
Description=VAAK shared Bluesky Jetstream spooler
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/srv/mkultra/html/api
Environment=VAAK_JETSTREAM_STATE=/var/lib/mkultra/ap/jetstream
ExecStartPre=/usr/bin/install -d -o www-data -g www-data -m 0750 /var/lib/mkultra/ap/jetstream /var/lib/mkultra/ap/jetstream/incoming
ExecStart=/opt/vaak-jetstream/bin/python /srv/mkultra/html/api/deploy/ap-bsky-jetstream.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
