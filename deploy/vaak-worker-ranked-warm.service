# Live Home/Local/Federated ranked ID-cache warm.
#   systemctl enable --now vaak-worker-ranked-warm.service
#
# Home (native): rebuilds vaak:timeline:ranked:v2:* in Rust (source=vaak-worker-native).
# Local/Federated: still spawn api/bin/ranked-warm.php until those views are ported.
# Flag: VAAK_RANKED_NATIVE_HOME=1 (default on). Set 0 to force PHP for Home too.

[Unit]
Description=VAAK Rust ranked timeline warm (Home native + PHP Local/Federated)
After=network.target postgresql.service redis-server.service
ConditionPathExists=/usr/local/bin/vaak-worker

[Service]
Type=simple
User=www-data
Group=www-data
Environment=VAAK_ENV_FILE=/etc/mkultra/vaak.env
Environment=VAAK_SHADOW_OWNER_ID=1
Environment=VAAK_API_ROOT=/srv/mkultra/html/api
Environment=VAAK_PHP_BIN=/usr/bin/php
Environment=VAAK_REDIS_URL=redis://127.0.0.1/0
Environment=AP_DB_DSN=pgsql:dbname=novalandia
Environment=VAAK_RANKED_WARM=1
Environment=VAAK_RANKED_NATIVE_HOME=1
Environment=VAAK_FEATURE_BLUESKY_TAB=1
Environment=RUST_LOG=info
# owner-id 0 = every non-disabled ap_users row each tick.
ExecStart=/usr/local/bin/vaak-worker ranked-warm --loop --interval-secs 60 --owner-id 0 --views home,local,feed
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
