# Live Mentions / Ice Cubes notification list warm (native projection→Redis).
#   systemctl enable --now vaak-worker-notif-list.service
#
# Writes vaak:notifications:v1:{owner}:{hash} from ap_notification_projection
# (source=vaak-worker-projection). PHP bin/notif-list-warm.php retired 0.6.63.
# 0.6.66: thin/empty projection triggers bin/notif-projection-fill.php once
# (cooldown-gated) so heavy accounts get background Mentions warm again.
# Mentions request-path still hydrates cold reads; set VAAK_NOTIF_LIST_RUST_PRIMARY=1
# (default) in vaak.env / FPM.

[Unit]
Description=VAAK Rust notif list warm (Mentions Redis writer)
After=network.target postgresql.service redis-server.service
ConditionPathExists=/usr/local/bin/vaak-worker

[Service]
Type=simple
User=www-data
Group=www-data
Environment=VAAK_ENV_FILE=/etc/mkultra/vaak.env
Environment=VAAK_SHADOW_OWNER_ID=1
Environment=VAAK_API_ROOT=/srv/mkultra/html/api
Environment=VAAK_REDIS_URL=redis://127.0.0.1/0
Environment=AP_DB_DSN=pgsql:dbname=novalandia
Environment=VAAK_FEATURE_BLUESKY_TAB=1
Environment=RUST_LOG=info
# owner-id 0 = every non-disabled ap_users row each tick.
# Native projection + skip-fresh / quiet_restamp; incomplete windows soft-skip.
ExecStart=/usr/local/bin/vaak-worker notif-list --loop --interval-secs 60 --owner-id 0 --limit 30
Restart=always
RestartSec=8
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
