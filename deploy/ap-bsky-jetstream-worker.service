[Unit]
Description=VAAK shared Bluesky Jetstream ingest worker
After=postgresql.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/srv/mkultra/html/api
Environment=AP_DB_DSN=pgsql:dbname=novalandia
Environment=VAAK_JETSTREAM_STATE=/var/lib/mkultra/ap/jetstream
ExecStart=/usr/bin/php /srv/mkultra/html/api/ap-bsky-jetstream-worker.php
