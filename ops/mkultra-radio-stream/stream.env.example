# /etc/mkultra-radio/stream.env  (root:mkradio, mode 0640)
# The stream key is a secret: it signs every segment as the mkultra-radio account.
ICECAST_URL=https://radio.mkultra.monster/radio
ICECAST_STATUS_URL=https://radio.mkultra.monster/status-json.xsl
ICECAST_MOUNT=/radio
STREAMPLACE_KEY=paste-the-key-from-stream.place/live-here
RADIO_STATE_DIR=/var/lib/mkultra-radio
# RADIO_LOGO=/var/lib/mkultra-radio/logo.png   # cover when no art is found
# STREAM_FPS=24        # 30 is smoother but costs ~25% more CPU
# STREAM_VBITRATE=2500k

# Hourly "Now playing" posts (mkultra-radio-announce.timer). Use an APP
# PASSWORD (Bluesky/PDS Settings > App passwords), never the real password.
BSKY_PDS=https://bsky.mkultra.monster
BSKY_HANDLE=mkultra-radio.bsky.mkultra.monster
BSKY_APP_PASSWORD=
# STREAM_PAGE_URL=https://stream.place/mkultra-radio.bsky.mkultra.monster
