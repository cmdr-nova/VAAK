[Unit]
Description=MKULTRA Radio 24/7 visualizer stream to Streamplace
After=network-online.target mkultra-radio-card.service
Wants=network-online.target mkultra-radio-card.service
# 24/7: never give up. Retries back off from 10 s up to 5 min while
# Icecast or Streamplace is down (RestartSteps needs systemd 254+).
StartLimitIntervalSec=0

[Service]
User=mkradio
Group=mkradio
EnvironmentFile=/etc/mkultra-radio/stream.env
ExecStart=/opt/mkultra-radio-stream/stream.sh
Restart=always
RestartSec=10
RestartSteps=6
RestartMaxDelaySec=300
# Isolation: the encode lives on ONE core and yields to everything else.
# AllowedCPUs pins it (cgroup cpuset, so ffmpeg's threads can't spread to
# other cores). On the grid box 2 is the quiet one (opensim-core is on 3/7/11/15,
# ollama bursts on 6/14, Shana's timer on 0/8). Check `lscpu -e` and
# override with `systemctl edit` elsewhere. On a
# hyperthreaded box you can give it both siblings of one physical core.
AllowedCPUs=2
CPUQuota=90%
CPUWeight=20
Nice=10
CPUSchedulingPolicy=batch
IOWeight=20
MemoryMax=768M
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
