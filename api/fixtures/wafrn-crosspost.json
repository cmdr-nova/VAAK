    },
    {
      "id": "identity-numeric",
      "op": "identity",
      "value": "9",
      "expect": {"identity": "9"}
    },
    {
      "id": "dids-from-also-known-as",
      "op": "dids",
      "also_known_as": [
        "at://did:plc:abc123",
        "https://app.wafrn.net/blog/admin",
        "https://bsky.app/profile/did:plc:def456"
      ],
      "expect": {"dids": ["did:plc:abc123", "did:plc:def456"]}
    },
    {
      "id": "normalize-asked-prefix",
      "op": "normalize",
      "value": "Anonymous asked: hi\n\nthere",
      "expect": {"text": "hithere"}
    },
    {
      "id": "normalize-whitespace",
      "op": "normalize",
      "value": "Hello  world",
      "expect": {"text": "Helloworld"}
    },
    {
      "id": "normalize-wafrn-note-ask",
      "op": "normalize",
      "value": "<p>anonymous asked </p> <blockquote>Desktop Stripper</blockquote> <p><a href=\"https://www.youtube.com/watch?v=CiVtoO65BRY\">https://www.youtube.com/watch?v=CiVtoO65BRY</a></p> <p>To properly see this ask, <a href=\"https://app.wafrn.net/fediverse/post/ask-html\">check the post in the original instance</a></p>",
      "expect": {"text": "DesktopStripperhttps://www.youtube.com/watch?v=CiVtoO65BRY"}
    },
    {
      "id": "normalize-wafrn-named-note-ask",
      "op": "normalize",
      "value": "<p>@fox@app.wafrn.net asked</p><blockquote>crows?</blockquote><p>yes</p>",
      "expect": {"text": "crows?yes"}
    },
    {
      "id": "ask-linked",
      "op": "ask",
      "linked": true,
      "text": "Anonymous asked: what is VAAK?\n\nA social bridge.",
      "expect": {
        "card": {
          "question": "what is VAAK?",
          "asker_label": "Anonymous",
          "answer": "A social bridge.",
          "asker_actor": ""
        }
      }
    },
    {
      "id": "ask-named",
      "op": "ask",
      "linked": true,
      "text": "Alice asked: how are you?\n\nI am well.",
      "expect": {
        "card": {
          "question": "how are you?",
          "asker_label": "Alice",
          "answer": "I am well.",
          "asker_actor": ""
        }
      }
    },
    {
      "id": "ask-unlinked",
      "op": "ask",
      "linked": false,
      "text": "Anonymous asked: what is VAAK?\n\nA social bridge.",
      "expect": {"card": null}
    },
    {
      "id": "ask-no-blank-line",
      "op": "ask",
      "linked": true,
      "text": "Anonymous asked: what is VAAK?\nA social bridge.",
      "expect": {"card": null}
    },
    {
      "id": "ask-html-breaks",
      "op": "ask",
      "linked": true,
      "text": "<p>Anonymous asked: what is VAAK?<br><br>A social bridge.</p>",
      "expect": {
        "card": {
          "question": "what is VAAK?",
          "asker_label": "Anonymous",
          "answer": "A social bridge.",
          "asker_actor": ""
        }
      }
    },
