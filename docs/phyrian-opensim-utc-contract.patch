+/** Explicit UTC bridge timestamp; ordinary HUD/public readout remains unchanged. */
+function bridge_public_player(array $row): array
+{
+    $player = public_player($row);
+    $raw = $player['last_decay_at'];
+    if (is_string($raw) && $raw !== '') {
+        $instant = DateTimeImmutable::createFromFormat('!Y-m-d H:i:s', $raw, new DateTimeZone('UTC'));
+        $errors = DateTimeImmutable::getLastErrors();
+        if ($instant !== false && ($errors === false || ($errors['warning_count'] === 0 && $errors['error_count'] === 0))) {
+            $player['last_decay_at'] = $instant->format('Y-m-d\TH:i:s\Z');
+        }
     }
     return $player;
 }
