#!/bin/sh
# Optional secret scan of the staged diff.
# Enable with: git config core.hooksPath .githooks
# Requires gitleaks on PATH (https://github.com/gitleaks/gitleaks#installing).
set -e
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so staged secrets were not scanned." >&2
  echo "Install gitleaks, or run: git config --unset core.hooksPath" >&2
  exit 1
fi
gitleaks protect --staged --redact --no-banner --config .gitleaks.toml
